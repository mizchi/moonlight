import {
  "mizchi/moonlight/model",
  "mizchi/moonlight/interaction",
  "mizchi/moonlight/import",
  "mizchi/moonlight/render",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [ "runScenario", "sceneToSvg", "applyToSvg", "describeSvg" ],
      "format": "esm",
    },
  },
)
