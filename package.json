{
  "name": "@mizchi/moonlight",
  "version": "0.1.0",
  "description": "Lightweight SVG editor like Excalidraw",
  "type": "module",
  "exports": {
    ".": {
      "import": "./js/api.js",
      "types": "./js/api.d.ts"
    }
  },
  "files": [
    "js",
    "_build/js/release/build/api"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "moon:build:compat": "moon build --target js --release && (test -e _build || ln -s target _build) && (test -e target || ln -s _build target)",
    "build:component": "pnpm moon:build:compat && rolldown -c rolldown.config.mjs",
    "build:all": "pnpm moon:build:compat && vite build && rolldown -c rolldown.config.mjs",
    "deploy": "pnpm build:all && wrangler deploy",
    "worker:dev": "pnpm build:all && wrangler dev",
    "example": "npx serve examples -p 3000",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:unit": "./scripts/moon-test.sh",
    "test:mbt": "./scripts/moon-test.sh",
    "test:visual-model": "playwright test e2e/visual-model.test.ts",
    "vlm:integrity": "vlmkit check integrity http://localhost:5173/ --no-ledger",
    "vlm:snapshot": "vlmkit snapshot http://localhost:5173/ --output .vlmkit/snapshots"
  },
  "devDependencies": {
    "@mizchi/vlmkit": "^0.22.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "happy-dom": "^20.14.5",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.11.0",
    "rolldown": "^1.2.8",
    "vite": "^8.3.0",
    "vite-plugin-moonbit": "^0.5.1",
    "wrangler": "^4.131.2"
  }
}
