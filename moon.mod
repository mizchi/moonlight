name = "mizchi/moonlight"

version = "0.1.2"

import {
  "mizchi/luna@0.25.0",
  "mizchi/js@0.12.2",
  "mizchi/js_browser@0.12.2",
  "mizchi/signals@0.6.5",
}

readme = "README.md"

repository = "https://github.com/mizchi/moonlight"

